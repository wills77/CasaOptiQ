# GEMINI_API_KEY: Optional for future AI features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL of the application.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Secret key used to sign HTTP-only session cookies in production.
SESSION_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"

# INITIAL_ADMIN_USER / INITIAL_ADMIN_PASSWORD: Used only on first server boot to seed the admin account.
# Change the password immediately after first login.
INITIAL_ADMIN_USER="Admin"
INITIAL_ADMIN_PASSWORD="REPLACE_BEFORE_PRODUCTION"

# PAYMENT_GATEWAY_PROVIDER: Optional Moroccan card gateway (e.g., CMI, Payzone)
# PAYMENT_GATEWAY_MERCHANT_ID=""
# PAYMENT_GATEWAY_SECRET_KEY=""
